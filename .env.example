# ==============================================================================
# OZARK — Root Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change-me-to-a-strong-secret-key
APP_DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ozark
POSTGRES_USER=ozark_user
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_URI=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# ── FastAPI Backend ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_WORKERS=1

# ── Next.js Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=OZARK
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── ML Pipeline ───────────────────────────────────────────────────────────────
ML_MODEL_DIR=./ml/models
ML_ARTIFACT_DIR=./ml/artifacts
ML_LOG_LEVEL=INFO

# ── Connectors ────────────────────────────────────────────────────────────────
CONNECTOR_BATCH_SIZE=500
CONNECTOR_LOG_LEVEL=INFO

# ── Docker ────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ozark
